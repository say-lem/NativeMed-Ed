        { "name": "POST /api/v1/cases - JSON body (admin)", "request": { "method": "POST", "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"stationNumber\": 1,\n  \"title\": \"Case title\",\n  \"consultationType\": \"Consultation\",\n  \"specialty\": \"Elderly Medicine/ Palliative\",\n  \"difficulty\": \"medium\",\n  \"isPublished\": false,\n  \"patientData\": {\n    \"name\": \"Patient Name\",\n    \"age\": 30,\n    \"gender\": \"male\",\n    \"pastMedicalHistory\": [],\n    \"drugHistory\": [],\n    \"recentConsultation\": {\n      \"seenBy\": \"Clinician\",\n      \"role\": \"Doctor\",\n      \"notes\": \"Consultation notes\"\n    },\n    \"bloodTestResults\": {\n      \"summary\": \"Summary\",\n      \"rows\": []\n    }\n  },\n  \"patientStory\": \"Story\",\n  \"markingScheme\": [{\"heading\": \"Section\", \"points\": [\"Point 1\"]}],\n  \"exampleExplanation\": \"Explanation\",\n  \"management\": [\"Step 1\"],\n  \"learningPoints\": \"Learning\",\n  \"furtherResources\": [{\"title\": \"NICE CKS\", \"url\": \"https://cks.nice.org.uk\"}]\n}" }, "url": "{{baseUrl}}/api/v1/cases" } },
        { "name": "POST /api/v1/cases - multipart with images (admin)", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "formdata", "formdata": [ { "key": "payload", "type": "text", "value": "{\n  \"stationNumber\": 1,\n  \"title\": \"Case title\",\n  \"consultationType\": \"Consultation\",\n  \"specialty\": \"Elderly Medicine/ Palliative\",\n  \"difficulty\": \"medium\",\n  \"isPublished\": false,\n  \"patientData\": { \"name\": \"Patient Name\", \"age\": 30, \"gender\": \"male\", \"pastMedicalHistory\": [], \"drugHistory\": [], \"recentConsultation\": { \"seenBy\": \"Clinician\", \"role\": \"Doctor\", \"notes\": \"Consultation notes\" }, \"bloodTestResults\": { \"summary\": \"Summary\", \"rows\": [] } },\n  \"patientStory\": \"Story\",\n  \"markingScheme\": [{\"heading\": \"Section\", \"points\": [\"Point 1\"]}],\n  \"exampleExplanation\": \"Explanation\",\n  \"management\": [\"Step 1\"],\n  \"learningPoints\": \"Learning\",\n  \"furtherResources\": [{\"title\": \"NICE CKS\", \"url\": \"https://cks.nice.org.uk\"}]\n}" }, { "key": "image", "type": "file", "src": "", "description": "Cover image (jpg/png/webp, max 5 MB)" }, { "key": "stationImage", "type": "file", "src": "", "description": "Station image (jpg/png/webp, max 5 MB)" } ] }, "url": "{{baseUrl}}/api/v1/cases" } },
        { "name": "PATCH /api/v1/cases/:id (admin)", "request": { "method": "PATCH", "header": [ { "key": "Authorization", "value": "Bearer {{accessToken}}" }, { "key": "Content-Type", "value": "application/json" } ], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Updated case title\"\n}" }, "url": "{{baseUrl}}/api/v1/cases/{{caseId}}" } },
