        { "name": "PATCH /api/v1/cases/:id/station-image (admin)", "request": { "method": "PATCH", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "body": { "mode": "formdata", "formdata": [ { "key": "stationImage", "type": "file", "src": "", "description": "Station image (jpg/png/webp, max 5 MB)" } ] }, "url": "{{baseUrl}}/api/v1/cases/{{caseId}}/station-image" } },
